extends ../layout

block content
  .card.col-12
    .card-header
      div
        h1 Sucursales (Tiendas)
        p.muted Listado de tiendas virtuales registradas en TechRetail.
      .actions
        a.btn.btn-primary(href="/tiendas/nuevo") Nueva tienda
        a.btn.btn-ghost(href="/") Volver al Panel

    table
      thead
        tr
          th ID
          th Nombre de Sucursal
          th Comercio
          th Ubicación
          th Estado
          th Acciones
      tbody
        each tienda in tiendas
          tr
            td
              a(href=`/tiendas/vista/${tienda._id}` style="color: var(--primary); text-decoration: none; font-weight: 600;")= tienda._id
            td= tienda.nombre_sucursal
            td= tienda.comercio_id ? tienda.comercio_id.nombre_comercio : 'Comercio no disponible'
            td= tienda.ubicacion
            td
              if tienda.estado === "Activo" || tienda.estado === "Activa"
                span.status-dot.status-dot--active(title=tienda.estado)
              else
                span.status-dot.status-dot--inactive(title=tienda.estado)
            td
              a.btn.btn-ghost(href=`/tiendas/vista/${tienda._id}` style="padding: 6px 10px; font-size: 13px;") Ver detalle
        else
          tr
            td(colspan="6") No hay tiendas registradas en este momento.
